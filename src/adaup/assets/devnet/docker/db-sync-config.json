{
  "EnableLogMetrics": false,
  "EnableLogging": true,
  "EnableFutureGenesis": true,
  "NetworkName": "devnet",
  "NodeConfigFile": "cardano-node.json",
  "PrometheusPort": 8080,
  "RequiresNetworkMagic": "RequiresMagic",
  "insert_options": {
    "tx_cbor": "enable",
    "tx_out": {
      "value": "enable",
      "use_address_table": true
    },
    "ledger": "enable",
    "shelley": {
      "enable": true
    },
    "multi_asset": {
      "enable": true
    },
    "metadata": {
      "enable": true
    },
    "plutus": {
      "enable": true
    },
    "governance": "enable",
    "offchain_pool_data": "enable",
    "offchain_vote_data": "enable",
    "pool_stat": "enable",
    "json_type": "text"
  },
  "defaultBackends": ["KatipBK"],
  "defaultScribes": [["StdoutSK", "stdout"]],
  "minSeverity": "Info",
  "options": {
    "cfokey": {
      "value": "Release-1.0.0"
    },
    "mapBackends": {},
    "mapSeverity": {
      "db-sync-node": "Info",
      "db-sync-node.Mux": "Error",
      "db-sync-node.Subscription": "Error"
    },
    "mapSubtrace": {}
  },
  "setupBackends": ["AggregationBK", "KatipBK"],
  "setupScribes": [
    {
      "scFormat": "ScText",
      "scKind": "StdoutSK",
      "scName": "stdout",
      "scRotation": null
    }
  ]
}
